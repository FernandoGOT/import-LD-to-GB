# LaunchDarkly
LD_API_TOKEN=api-...
LD_API_BASE_URL=https://app.launchdarkly.com/api/v2
LD_API_VERSION=20240415

# GrowthBook
GB_API_KEY=secret_...
# Projects / environments / saved-groups (v1)
GB_API_BASE_URL=https://api.growthbook.io/api/v1
# Features (v2) — se omitido, deriva trocando /api/v1 → /api/v2
# GB_FEATURES_API_BASE_URL=https://api.growthbook.io/api/v2

# Segurança
# true = só gera relatório, não atualiza nada
# false = envia updates para o GrowthBook
DRY_RUN=true

# Estratégia de projeto:
# auto = tenta mapear LD project key -> GB publicId/id/name
# json = usa PROJECT_MAP_JSON
PROJECT_MATCH_STRATEGY=auto

# Usado somente se PROJECT_MATCH_STRATEGY=json
# chave = LD project key, valor = GrowthBook project id
PROJECT_MAP_JSON={"ld-project-key":"prj__growthbook_id"}

# --- sync (variações) ---
# Estratégia de ambientes (marcados na mesma regra force):
# existing = usa todos os environments que já existem na feature
# list = usa somente os listados em GB_TARGET_ENVIRONMENTS (se existirem na feature)
GB_ENV_STRATEGY=existing
GB_TARGET_ENVIRONMENTS=dev,staging,production

# Nunca deixe true sem pensar bem.
# Se false, o script não cria um novo bloco environments[envKey] em nenhuma feature.
ALLOW_CREATE_ENV_BLOCKS=false

# --- migrate (migração completa) ---
MIGRATE_CREATE_PROJECTS=true
MIGRATE_CREATE_ENVIRONMENTS=true
MIGRATE_CREATE_FEATURES=true
MIGRATE_CREATE_SAVED_GROUPS=true
MIGRATE_IMPORT_TARGETING=true
MIGRATE_IMPORT_VARIATIONS=true
SEGMENT_LIST_ATTRIBUTE_KEY=id
# Obrigatório em algumas instâncias self-hosted do GrowthBook ao criar features
GB_FEATURE_OWNER=ld-migrate

# Opcional
REQUEST_DELAY_MS=250
# Cache local das respostas do LaunchDarkly (projects/environments/flags/etc).
# Apague a pasta para forçar novos requests à API.
# LD_CACHE_DIR=./ld-cache
# sync default: ./ld-growthbook-variation-report.json
# migrate default: ./ld-growthbook-migrate-report.json
REPORT_PATH=./ld-growthbook-variation-report.json

# Ignore/remap de projetos, ambientes, flags e variações (opcional).
# Se o arquivo não existir, a importação segue sem remap/ignore.
# Veja config.example.json e a seção no README.
CONFIG_PATH=./config.json
